{
    "name": "pokedex",
    "version": "1.0.0",
    "description": "A Pokédex built with React, Redux Toolkit Query and Firebase: browse, filter, compare and favourite Pokémon.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm run test:run && npm run build"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.14.0",
        "firebase": "^13.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "prettier": "^3.9.10",
        "sass": "^1.108.1",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.14.7",
        "eslint": {
            "minimatch": "^11.0.5"
        }
    }
}
